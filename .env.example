# Lokasi data. Kosongkan untuk memakai folder data pengguna:
#   Windows: %APPDATA%\PIB-Penilaian | Linux: ~/.local/share/PIB-Penilaian
# PIB_DATA_DIR="D:\DataPIB"
# Backup otomatis: arahkan ke folder OneDrive/Google Drive/flashdisk agar aman saat ganti device
# PIB_BACKUP_DIR="C:\Users\NAMA\OneDrive\PIB-Backup"
# PIB_BACKUP_INTERVAL_HOURS=2
# PIB_BACKUP_KEEP=30
# Untuk production gunakan secret acak minimal 32 karakter.
SESSION_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
